# =============================================================================
# MapFeux — variables d'environnement (modèle)
# Copier en .env.local (web) et services/geo-worker/.env (worker).
# Aucun secret ne doit être committé. Voir cahier §22.3 et annexe C.
# =============================================================================

# -----------------------------------------------------------------------------
# Application web (apps/web)
# -----------------------------------------------------------------------------
# Projet Supabase hébergé — https://supabase.com/dashboard/project/_/settings/api
# Rubrique « Publishable key » du tableau de bord.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Rubrique « Secret keys ». Serveur uniquement : ne jamais préfixer
# NEXT_PUBLIC_, ne jamais exposer au client. Remplace l'ancienne clé
# `service_role` au format JWT, que le cahier annexe C nommait
# SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

PUBLIC_APP_URL=http://localhost:3000
MAP_STYLE_URL=
SENTRY_DSN=
API_CACHE_SECRET=

# -----------------------------------------------------------------------------
# Worker géospatial (services/geo-worker)
# -----------------------------------------------------------------------------
# Chaîne de connexion Postgres du projet Supabase (pooler ou connexion directe)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET_RAW=raw
SUPABASE_STORAGE_BUCKET_DERIVED=derived
# Stockage froid PR-1 (archives AROME) — jamais purgé, voir cahier §12.4
SUPABASE_STORAGE_BUCKET_COLD=cold

# Base de calibration — projet Supabase distinct (mapfeux-calibration).
# Le banc et les outils expérimentaux refusent de démarrer si elle désigne la
# même base que DATABASE_URL : le banc efface et réécrit fire.events.
CALIBRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.yyyyyyyyyyyyyyyy.supabase.co:5432/postgres

# NASA FIRMS — clé gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Météo-France — une clé PAR APPLICATION du portail. Poser la clé d'une autre
# application produit un 403 sans motif visible. METEOFRANCE_API_KEY (nom
# générique) est déprécié : encore lu en repli, plus jamais documenté.
METEOFRANCE_VIGILANCE_API_KEY=

# Copernicus CAMS — Atmosphere Data Store
COPERNICUS_URL=https://ads.atmosphere.copernicus.eu/api
COPERNICUS_KEY=

# Observabilité
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
ENVIRONMENT=local
